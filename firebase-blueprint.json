{
  "project_id": "nipponguay",
  "collections": [
    {
      "name": "productos",
      "description": "Catálogo de productos e inventario gastronómico (bebidas, comidas, fardos y stock).",
      "security_rules": {
        "read": "true",
        "write": "request.auth != null"
      },
      "schema": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "boxSize": { "type": "number" },
        "barcode": { "type": "string", "optional": true },
        "unit": { "type": "string" }
      }
    },
    {
      "name": "ventas",
      "description": "Registro de tickets y comandas cobradas en el POS con descuento automático de stock.",
      "security_rules": {
        "read": "request.auth != null",
        "write": "request.auth != null"
      },
      "schema": {
        "items": { "type": "array" },
        "total": { "type": "number" },
        "mesa": { "type": "string" },
        "fecha": { "type": "string" }
      }
    },
    {
      "name": "comandas_activas",
      "description": "Comandas enviadas a la cocina en tiempo real desde la terminal de mozos.",
      "security_rules": {
        "read": "true",
        "write": "true"
      },
      "schema": {
        "mesa": { "type": "string" },
        "items": { "type": "array" },
        "estado": { "type": "string" },
        "fecha": { "type": "string" },
        "total": { "type": "number", "optional": true },
        "nota": { "type": "string", "optional": true }
      }
    },
    {
      "name": "users",
      "description": "Fichas de perfiles de usuarios de la Escribanía.",
      "security_rules": {
        "read": "request.auth != null && request.auth.uid == resource.id",
        "write": "request.auth != null && request.auth.uid == resource.id"
      },
      "schema": {
        "role": {
          "type": "string",
          "description": "admin or user"
        },
        "created_at": {
          "type": "timestamp"
        }
      }
    },
    {
      "name": "personas",
      "description": "Personas involucradas en Pagarés (clientes, acreedores, deudores).",
      "security_rules": {
        "read": "request.auth != null && request.auth.uid == resource.data.user_id",
        "write": "request.auth != null && request.auth.uid == request.resource.data.user_id"
      },
      "schema": {
        "user_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tipo_persona": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "apellido": {
          "type": "string",
          "optional": true
        },
        "tipo_documento": {
          "type": "string"
        },
        "nro_documento": {
          "type": "string"
        },
        "telefono": {
          "type": "string",
          "optional": true
        },
        "email": {
          "type": "string",
          "optional": true
        },
        "domicilio": {
          "type": "string",
          "optional": true
        },
        "representante_id": {
          "type": "string",
          "optional": true
        }
      }
    },
    {
      "name": "pagares",
      "description": "Pagarés registrados por los usuarios.",
      "security_rules": {
        "read": "request.auth != null && request.auth.uid == resource.data.user_id",
        "write": "request.auth != null && request.auth.uid == request.resource.data.user_id"
      },
      "schema": {
        "user_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "correlativo": {
          "type": "number"
        },
        "certificado_firmas_nro": {
          "type": "string"
        },
        "tipo_negociacion": {
          "type": "string"
        },
        "moneda": {
          "type": "string"
        },
        "valor_total": {
          "type": "number"
        },
        "frecuencia_id": {
          "type": "string"
        },
        "fecha_primer_pago": {
          "type": "string"
        },
        "entrega_inicial": {
          "type": "number",
          "optional": true
        },
        "acreedor_id": {
          "type": "string"
        },
        "deudor_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "creator_role": {
          "type": "string"
        },
        "cronograma": {
          "type": "array"
        }
      }
    },
    {
      "name": "knowledge_docs",
      "description": "Documentos subidos por los usuarios para entrenamiento.",
      "security_rules": {
        "read": "request.auth != null && request.auth.uid == resource.data.user_id",
        "write": "request.auth != null && request.auth.uid == request.resource.data.user_id"
      },
      "schema": {
        "user_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        }
      }
    }
  ]
}