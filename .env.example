# ==============================================================
# GASTROPOS - PLANTILLA DE VARIABLES DE ENTORNO VITE (.env)
# ==============================================================
# Para configurar tu entorno local:
# 1. Copia este archivo y renómbralo a '.env' o '.env.local'
# 2. Pega los valores de tus credenciales en cada variable.
# 3. NUNCA subas tu archivo '.env' a GitHub (ya está protegido en .gitignore).

# Credenciales de tu aplicación web en Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base de datos Firestore (Opcional si usas '(default)' o el ID asignado)
VITE_FIREBASE_DATABASE_ID=

# Credenciales complementarias
VITE_ADMIN_UID=
GEMINI_API_KEY=
