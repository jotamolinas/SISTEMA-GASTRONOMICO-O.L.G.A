# ==============================================================
# GASTROPOS - PLANTILLA DE VARIABLES DE ENTORNO VITE (.env.example)
# ==============================================================
# Instrucciones de configuración:
# 1. Copia este archivo y renómbralo exactamente a: .env
# 2. Completa los valores con las credenciales de tu proyecto.
# 3. NUNCA agregues valores reales a este archivo (.env.example).
# 4. El archivo .env está protegido en .gitignore y NUNCA debe subirse a Git.
# ==============================================================

# Credenciales de Firebase Web Client
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base de datos Firestore (Opcional, por defecto suele ser '(default)')
VITE_FIREBASE_DATABASE_ID=(default)

# UID de Administrador / SuperAdmin
VITE_ADMIN_UID=

# Inteligencia Artificial / Gemini API Key (si aplica)
GEMINI_API_KEY=
